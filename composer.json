{
    "name": "malhar-rathod/bilibili-media",
    "type": "typo3-cms-extension",
    "description": "Bilibili Online Media support for TYPO3 Text & Media element (v12, v13, v14)",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Malhar Rathod",
            "email": "malhar.b.rathod@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1 || ^8.2 || ^8.3 || ^8.4",
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "MalharRathod\\BilibiliMedia\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "bilibili_media"
        }
    }
